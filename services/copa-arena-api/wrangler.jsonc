{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copa-life-arena",
  "main": "src/index.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGINS": "https://copa.life,https://www.copa.life,https://localhost,capacitor://localhost"
  },
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 0.25, "invocation_logs": true},
    "traces": {"enabled": true, "head_sampling_rate": 0.05}
  },
  "triggers": {"crons": ["23 3 * * *"]},
  "ratelimits": [
    {"name": "ARENA_LIMITER", "namespace_id": "42001", "simple": {"limit": 30, "period": 60}}
  ],
  "analytics_engine_datasets": [
    {"binding": "ARENA_ANALYTICS", "dataset": "copa_life_arena_events"}
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "copa-life-arena",
      "database_id": "0d1d6b16-962b-480c-9daf-ac6d8c85b4b3",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "ARENA_MATCHMAKER", "class_name": "ArenaMatchmaker"},
      {"name": "ARENA_ROOM", "class_name": "ArenaRoom"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ArenaMatchmaker", "ArenaRoom"]}
  ]
}
