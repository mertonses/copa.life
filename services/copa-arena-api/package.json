{
  "name": "copa-life-arena-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "types": "wrangler types --config wrangler.jsonc worker-configuration.d.ts",
    "check:types": "wrangler types --config wrangler.jsonc --check worker-configuration.d.ts",
    "check:deploy": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler-dry-run",
    "check:startup": "wrangler check startup --config wrangler.jsonc",
    "smoke:live": "node scripts/smoke-live.mjs",
    "check": "npm test && npm run check:types && npm run check:deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  },
  "overrides": {
    "undici": "7.29.0"
  },
  "dependencies": {
    "copa-life": "file:../.."
  }
}
