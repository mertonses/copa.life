{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "copa-life-arena-test",
  "main": "src/index.js",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "GOOGLE_TEST_MODE": "true",
    "GOOGLE_CLIENT_IDS": "test.apps.googleusercontent.com"
  },
  "d1_databases": [
    {"binding": "DB", "database_name": "copa-life-arena-test", "database_id": "local-arena-test", "migrations_dir": "migrations"}
  ],
  "durable_objects": {
    "bindings": [
      {"name": "ARENA_MATCHMAKER", "class_name": "ArenaMatchmaker"},
      {"name": "ARENA_ROOM", "class_name": "ArenaRoom"},
      {"name": "ARENA_TOURNAMENT", "class_name": "ArenaTournament"}
    ]
  },
  "migrations": [
    {"tag": "v1", "new_sqlite_classes": ["ArenaMatchmaker", "ArenaRoom"]},
    {"tag": "v2", "new_sqlite_classes": ["ArenaTournament"]}
  ]
}
